DJANGO_SETTINGS_MODULE=config.settings.local
DJANGO_SECRET_KEY=replace-me
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
APP_VERSION=dev
EXTERNAL_SYSTEM_MODE=mock
WORKBENCH_ENABLED=false
WORKBENCH_ALLOWED_HOSTS=
WORKBENCH_MAX_UPLOAD_BYTES=10485760

DB_ENGINE=mysql
FRONTEND_DIST_DIR=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_DATABASE=alkaid_dev
MYSQL_USER=workflow
MYSQL_PASSWORD=replace-me
MYSQL_SSL_DISABLED=true

CELERY_BROKER_URL=amqp://workflow:workflow@127.0.0.1:5672//
CELERY_QUEUE=alkaid-local
CELERY_TASK_ALWAYS_EAGER=false
DEV_START_WORKER=true

JOB_RETENTION_HOURS=720
JOB_LOG_RETENTION_HOURS=168
JOB_MAX_LOGS=5000
JOB_MAX_HTTP_BODY_BYTES=65536
JOB_RECONCILE_BATCH_SIZE=500
JOB_SSE_POLL_SECONDS=1
JOB_SSE_HEARTBEAT_SECONDS=15
PRODUCT_APPLICATION_TIMEOUT_SECONDS=300

# Environment code -> application-link service base URL.
# Keep real intranet IPs in .env.local only.
APPLICATION_LINK_BASE_URLS={"UAT1":"http://link-uat1-host:8090","UAT2":"http://link-uat2-host:8090","UATC":"http://link-uatc-host:8090"}
APPLICATION_LINK_URL_MODE=internal
APPLICATION_LINK_API_TOKEN=
APPLICATION_LINK_FORM_SIGN=
APPLICATION_LINK_SIGN_REQUIRED=false
APPLICATION_LINK_PROTOCOL_CONFIRMED=false
APPLICATION_LINK_SIGNER=
APPLICATION_LINK_TIMESTAMP_FORMAT=%Y%m%d%H%M%S

# Environment code -> CJDK-JYRC agreement/page base URL.
CJDK_JYRC_BASE_URLS={"UAT1":"http://uat1-host:8090","UAT2":"http://uat2-host:8090","UATC":"http://uatc-host:8090"}
CJDK_JYRC_CHANNEL=13
CJDK_JYRC_SCENE=SC00015
CJDK_JYRC_PRODUCT_ID=CJDK-ZHHX
CJDK_JYRC_PRODUCT_SUBDIVISION=partners
CJDK_JYRC_PRODUCT_SUBDIVISION_ENCODE=202605077231204
CJDK_JYRC_BUSINESS_NO=00000000
CJDK_JYRC_FCOS_TEMPLATE_NOS=2209201448031
CJDK_JYRC_DEFAULT_PROJECT_ID=
CJDK_JYRC_DEFAULT_ID_TYPE=
CJDK_JYRC_FORM_SIGN=
CJDK_JYRC_TIMESTAMP_FORMAT=%Y-%m-%d %H:%M:%S
CJDK_JYRC_APPLICATION_LINK_APP_ID=
CJDK_JYRC_APPLICATION_LINK_PRIVATE_KEY=
CJDK_JYRC_APPLICATION_LINK_PUBLIC_KEY=
APPLICATION_LINK_JAVA_SDK_DIR=
APPLICATION_LINK_JAVA_EXECUTABLE=
APPLICATION_LINK_JAVA_JAR=
APPLICATION_LINK_JAVA_MAIN_CLASS=
APPLICATION_LINK_JAVA_OUTPUT_ENCODING=gbk
APPLICATION_LINK_JAVA_TIMEOUT_SECONDS=120

HTTP_TIMEOUT_SECONDS=10
HTTP_CONNECT_TIMEOUT_SECONDS=5
HTTP_WRITE_TIMEOUT_SECONDS=10
HTTP_POOL_TIMEOUT_SECONDS=5
HTTP_MAX_RETRIES=2
HTTP_RETRY_BACKOFF_SECONDS=0.2
HTTP_RETRY_MAX_BACKOFF_SECONDS=5

WEB_PORT=8000
