{
  "mode": "real",
  "applicationLinkUrlMode": "internal",
  "javaGateway": {
    "sdkDir": "D:/application-link-sdk",
    "javaExecutable": "D:/jdk/bin/java.exe",
    "jar": "application-link.jar",
    "mainClass": "com.example.ApplicationLinkMain",
    "outputEncoding": "gbk",
    "timeoutSeconds": 120
  },
  "environments": {
    "UAT1": {
      "agreementBaseUrl": "http://agreement-uat1-host:port"
    },
    "UAT2": {
      "agreementBaseUrl": "http://agreement-uat2-host:port"
    },
    "UATC": {
      "agreementBaseUrl": "http://agreement-uatc-host:port"
    }
  }
}
