{
  "mode": "real",
  "applicationLinkUrlMode": "internal",
  "javaGateway": {
    "sdkDir": "D:/application-link-sdk",
    "javaExecutable": "D:/jdk/bin/java.exe",
    "jar": "application-link.jar",
    "mainClass": "com.example.ApplicationLinkMain",
    "outputEncoding": "gbk",
    "timeoutSeconds": 120
  },
  "secrets": {
    "cjdkJyrc.applicationLink.appId": "由部署环境提供",
    "cjdkJyrc.applicationLink.privateKey": "由部署环境提供",
    "cjdkJyrc.applicationLink.publicKey": "由部署环境提供"
  },
  "responseLimits": {
    "maxJsonBytes": 5242880,
    "maxHtmlBytes": 2097152,
    "maxRedirects": 10,
    "maxAgreementTemplates": 50,
    "maxPreviewDocuments": 50,
    "maxBase64Characters": 29360128,
    "maxDecodedDocumentBytes": 20971520,
    "maxTotalDocumentBytes": 52428800
  },
  "environments": {
    "UAT1": {
      "agreementBaseUrl": "http://12.244.142.116:8090",
      "sessionUrlTemplate": "http://12.244.142.116:8090/h5main/microservice/startSceneLoanOpenBankApply.ajax?auth={auth}",
      "sessionMethod": "POST",
      "verifySsl": false,
      "session": {
        "requiredCookies": [
          "token_id",
          "JSESSIONID",
          "X-FCOS-SESSIONID"
        ],
        "requiredHeaders": [
          "X-Sd",
          "X-Token"
        ],
        "requiredAnyHeaders": []
      },
      "urlPolicy": {
        "allowedSchemes": ["http"],
        "allowedHosts": ["12.244.142.116"],
        "allowedPorts": [8090],
        "allowCrossHostRedirect": false,
        "forwardSessionHeadersToHosts": ["12.244.142.116"],
        "maxRedirects": 10
      }
    },
    "UAT2": {
      "agreementBaseUrl": "http://agreement-uat2-host:8090",
      "sessionUrlTemplate": "http://agreement-uat2-host:8090/session/init?auth={auth}",
      "sessionMethod": "POST",
      "verifySsl": true,
      "session": {
        "requiredCookies": ["token_id", "JSESSIONID", "X-FCOS-SESSIONID"],
        "requiredHeaders": ["X-Sd", "X-Token"],
        "requiredAnyHeaders": []
      },
      "urlPolicy": {
        "allowedSchemes": ["http"],
        "allowedHosts": ["agreement-uat2-host"],
        "allowedPorts": [8090],
        "allowCrossHostRedirect": false,
        "forwardSessionHeadersToHosts": ["agreement-uat2-host"],
        "maxRedirects": 10
      }
    },
    "UATC": {
      "agreementBaseUrl": "http://agreement-uatc-host:8090",
      "sessionUrlTemplate": "http://agreement-uatc-host:8090/session/init?auth={auth}",
      "sessionMethod": "POST",
      "verifySsl": true,
      "session": {
        "requiredCookies": ["token_id", "JSESSIONID", "X-FCOS-SESSIONID"],
        "requiredHeaders": ["X-Sd", "X-Token"],
        "requiredAnyHeaders": []
      },
      "urlPolicy": {
        "allowedSchemes": ["http"],
        "allowedHosts": ["agreement-uatc-host"],
        "allowedPorts": [8090],
        "allowCrossHostRedirect": false,
        "forwardSessionHeadersToHosts": ["agreement-uatc-host"],
        "maxRedirects": 10
      }
    }
  }
}
