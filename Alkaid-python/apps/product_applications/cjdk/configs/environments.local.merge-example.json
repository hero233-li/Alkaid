{
  "javaGateway": {
    "sdkDir": "D:/你的申请链接JavaSDK目录",
    "javaExecutable": "D:/你的JDK/bin/java.exe",
    "jar": "你的申请链接Jar文件名.jar",
    "mainClass": "实际Java主类全限定名",
    "outputEncoding": "gbk",
    "timeoutSeconds": 120
  },
  "secrets": {
    "cjdkJyrc.applicationLink.appId": "本机实际 appId",
    "cjdkJyrc.applicationLink.privateKey": "本机实际私钥",
    "cjdkJyrc.applicationLink.publicKey": "本机实际公钥"
  },
  "environments": {
    "UAT1": {
      "agreementBaseUrl": "http://实际内网主机:8090",
      "sessionUrlTemplate": "http://实际内网主机:8090/h5main/microservice/startSceneLoanOpenBankApply.ajax?auth={auth}",
      "sessionMethod": "POST",
      "verifySsl": false,
      "session": {
        "requiredCookies": [
          "token_id",
          "JSESSIONID",
          "X-FCOS-SESSIONID"
        ],
        "requiredHeaders": [
          "X-Sd",
          "X-Token"
        ],
        "requiredAnyHeaders": []
      },
      "urlPolicy": {
        "allowedSchemes": ["http", "https"],
        "allowedHosts": ["实际内网主机"],
        "allowedPorts": [8090, 443],
        "allowCrossHostRedirect": false,
        "forwardSessionHeadersToHosts": ["实际内网主机"],
        "maxRedirects": 10
      }
    }
  }
}
